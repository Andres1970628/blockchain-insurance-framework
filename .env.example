# Network Configuration
ALCHEMY_API_KEY=your_alchemy_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Private Keys (Never commit actual keys!)
SEPOLIA_PRIVATE_KEY=your_sepolia_private_key_here
POLYGON_PRIVATE_KEY=your_polygon_private_key_here

# Gas Reporting
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/blockchain_insurance
REDIS_URL=redis://localhost:6379

# Chainlink Configuration
CHAINLINK_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key
CHAINLINK_ORACLE_ADDRESS=0x...

# Fraud Detection APIs
TRM_LABS_API_KEY=your_trm_labs_key_here
CHAINANALYSIS_API_KEY=your_chainanalysis_key_here
CRYSTAL_INTELLIGENCE_API_KEY=your_crystal_intelligence_key_here

# Privacy & Identity
DID_REGISTRY_ADDRESS=0x...
ZKP_CIRCUIT_PATH=./zk-circuits/eligibility.circom

# JWT & Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=24h

# Email & Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password

# Monitoring & Logging
SENTRY_DSN=your_sentry_dsn_here
ELASTICSEARCH_URL=http://localhost:9200
GRAFANA_API_URL=http://localhost:3000
